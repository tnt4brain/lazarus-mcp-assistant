      <Item20>
        <Filename Value="McpOptions.pas"/>
        <UnitName Value="McpOptions"/>
      </Item20>
      <Item21>
        <Filename Value="McpSettingsFile.pas"/>
        <UnitName Value="McpSettingsFile"/>
      </Item21>
      <Item22>
        <Filename Value="McpRefKeeper.pas"/>
        <UnitName Value="McpRefKeeper"/>
