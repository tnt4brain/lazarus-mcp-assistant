<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="LazMcpAssistant"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Sergei Pechenko"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-dUseCThreads"/>
      </Other>
    </CompilerOptions>
    <Description Value="A completely generic, brand-agnostic Model Context Protocol (MCP) IDE Assistant client for the Lazarus RAD IDE and Free Pascal ecosystem."/>
    <License Value="BSD-3-Clause"/>
    <Version Major="0" Minor="9"/>
    <Files Count="22">
      <Item1>
        <Filename Value="lazmcpassistant.pas"/>
        <UnitName Value="LazMcpAssistant"/>
