        <UnitName Value="McpToolsEditor"/>
      </Item9>
      <Item10>
        <Filename Value="McpToolsBuild.pas"/>
        <UnitName Value="McpToolsBuild"/>
      </Item10>
      <Item11>
        <Filename Value="McpToolsCodeTools.pas"/>
        <UnitName Value="McpToolsCodeTools"/>
      </Item11>
      <Item12>
        <Filename Value="McpToolsForms.pas"/>
        <UnitName Value="McpToolsForms"/>
      </Item12>
      <Item13>
        <Filename Value="McpToolsProject.pas"/>
        <UnitName Value="McpToolsProject"/>
      </Item13>
      <Item14>
        <Filename Value="McpToolsGit.pas"/>
        <UnitName Value="McpToolsGit"/>
