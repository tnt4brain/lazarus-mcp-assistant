        <Filename Value="mcpidestate.pas"/>
        <UnitName Value="McpIdeState"/>
      </Item3>
      <Item4>
        <Filename Value="mcplayoutpanel.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="McpLayoutPanel"/>
      </Item4>
      <Item5>
        <Filename Value="mcpideserver.pas"/>
        <UnitName Value="McpIdeServer"/>
      </Item5>
