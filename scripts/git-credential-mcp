#!/bin/sh
# git credential helper for a git_serve link (ADR-035): answers git's "get" with the user
# "mcp" and the TOTP code (RFC 6238, HMAC-SHA1, 6 digits, 30 s) of the link's key.
#   git config credential.helper "!sh ~/.git-credential-mcp <key as hex>"
# git runs it as   git-credential-mcp <key> get   and writes what it knows to stdin.
# Needs sh, date and openssl.  The same text is in the answer of git_serve link
# (McpToolsGitServe.pas); keep the two equal.
[ "$2" = get ] || exit 0
key=$1
cat > /dev/null
t=$(( $(date +%s) / 30 ))
msg=
i=7
while [ $i -ge 0 ]; do
  msg="$msg$(printf "\\\\%03o" $(( (t >> (8 * i)) & 255 )))"
  i=$(( i - 1 ))
done
mac=$(printf "$msg" | openssl dgst -sha1 -mac HMAC -macopt "hexkey:$key" -hex | cut -d= -f2 | tr -d " ")
off=$(( 0x$(printf %s "$mac" | cut -c40) ))
h=$(printf %s "$mac" | cut -c$(( off * 2 + 1 ))-$(( off * 2 + 8 )))
code=$(( (0x$h & 0x7fffffff) % 1000000 ))
printf "username=mcp\npassword=%06d\n" $code
